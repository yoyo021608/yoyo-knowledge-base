# 应用环境
APP_ENV=development

# 本地开发和测试默认使用 fake，不需要真实模型密钥
# 接入真实模型时改为 openai
LLM_PROVIDER=fake

# 数据库 / 缓存
# .env.example 只提供格式示例，不保证这些账号已经存在
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/knowledge_base
REDIS_URL=redis://localhost:6379/0

# 认证
# 仅用于示例；本地 .env 中请替换为自己的随机长字符串
JWT_SECRET=change-this-local-secret
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# 模型接入
# LLM_PROVIDER=fake 时可以保持 OPENAI_API_KEY 为空
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini

# 文件与跨域
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173

# 前端（Vite 只暴露 VITE_ 前缀的变量）
VITE_API_BASE_URL=http://localhost:8000
